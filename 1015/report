[6.10.2 알고리즘 워크벤치 (Algorithm Workbench)]

; 1. AL의 ASCII 숫자를 이진수 값으로 변환[cite: 3]
and al, 0Fh

; 2. 32비트 메모리 피연산자의 패리티 계산 (B0 XOR B1 XOR B2 XOR B3)[cite: 3]
mov al, byte ptr [mem32]
xor al, byte ptr [mem32+1]
xor al, byte ptr [mem32+2]
xor al, byte ptr [mem32+3]

; 3. SetX에는 속하지만 SetY에는 속하지 않는 비트를 EAX에 생성[cite: 3]
mov eax, SetX
mov ebx, SetY
not ebx
and eax, ebx

; 4. DX의 부호 없는 정수가 CX보다 작거나 같을 때 L1으로 점프[cite: 3]
cmp dx, cx
jbe L1

; 5. AX의 부호 있는 정수가 CX보다 클 때 L2로 점프[cite: 3]
cmp ax, cx
jg L2

; 6. AL의 비트 0과 1을 지우고, 결과가 0이면 L3, 아니면 L4로 점프[cite: 4]
and al, 11111100b
jz L3
jmp L4

; 7. if (val1 > ecx) AND (ecx > edx) X = 1 else X = 2[cite: 4]
cmp val1, ecx
jle L_Else
cmp ecx, edx
jle L_Else
mov X, 1
jmp L_End
L_Else:
mov X, 2
L_End:

; 8. if (ebx > ecx) OR (ebx > val1) X = 1 else X = 2[cite: 4]
cmp ebx, ecx
jg L_If
cmp ebx, val1
jg L_If
mov X, 2
jmp L_End
L_If:
mov X, 1
L_End:

; 9. if (ebx > ecx AND ebx > edx) OR (edx > eax) X = 1 else X = 2[cite: 4]
cmp ebx, ecx
jle L_OrCheck
cmp ebx, edx
jg L_If
L_OrCheck:
cmp edx, eax
jg L_If
mov X, 2
jmp L_End
L_If:
mov X, 1
L_End:

; 10. while N > 0 내부의 if N != 3 AND (N < A OR N > B)[cite: 4]
L_While:
    cmp N, 0
    jle L_EndWhile
    cmp N, 3
    je L_Else
    cmp N, A
    jl L_If
    cmp N, B
    jg L_If
    jmp L_Else
L_If:
    sub N, 2
    jmp L_While
L_Else:
    sub N, 1
    jmp L_While
L_EndWhile:

