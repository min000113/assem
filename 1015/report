[6.11.2 프로그래밍 연습문제 (Programming Exercises) 핵심 로직]

; 1. 배열 채우기 (Filling an Array)[cite: 5]
FillArray PROC
    push ebp
    mov ebp, esp
    pushad
    mov edi, [ebp+20]
    mov ecx, [ebp+16]
    mov ebx, [ebp+12]
    mov edx, [ebp+8]
    mov eax, edx
    sub eax, ebx
    inc eax
L1: push eax
    call RandomRange
    add eax, ebx
    mov [edi], eax
    add edi, 4
    pop eax
    loop L1
    popad
    pop ebp
    ret 16
FillArray ENDP

; 2. 지정된 범위 내의 배열 요소 합산 (Summing Array Elements in a Range)[cite: 5]
CalcSum PROC
    push ebp
    mov ebp, esp
    push ebx
    push ecx
    push edx
    push esi
    mov esi, [ebp+20]
    mov ecx, [ebp+16]
    mov ebx, [ebp+12]
    mov edx, [ebp+8]
    xor eax, eax
L1: mov edi, [esi]
    cmp edi, ebx
    jl L_Next
    cmp edi, edx
    jg L_Next
    add eax, edi
L_Next:
    add esi, 4
    loop L1
    pop esi
    pop edx
    pop ecx
    pop ebx
    pop ebp
    ret 16
CalcSum ENDP

; 3. 시험 점수 평가 (Test Score Evaluation)[cite: 5, 6]
CalcGrade PROC
    cmp eax, 90
    jae IsA
    cmp eax, 80
    jae IsB
    cmp eax, 70
    jae IsC
    cmp eax, 60
    jae IsD
    mov al, 'F'
    jmp EndProg
IsA: mov al, 'A'
     jmp EndProg
IsB: mov al, 'B'
     jmp EndProg
IsC: mov al, 'C'
     jmp EndProg
IsD: mov al, 'D'
EndProg:
    ret
CalcGrade ENDP

; 6. 확률 및 색상 (Probabilities and Colors)[cite: 7]
; 루프 내에서 난수(0~9)를 생성하여 색상 분기 처리
mov eax, 10
call RandomRange
cmp eax, 2
jbe White_Label    ; 0, 1, 2 (30%)
cmp eax, 3
je Blue_Label      ; 3 (10%)
jmp Green_Label    ; 4~9 (60%)

; 8. PIN 검증 (Validating a PIN)[cite: 7, 8]
; esi를 인덱스로 사용하여 검증 (루프 내부 로직)
mov al, [edi+esi]
cmp al, min_array[esi]
jb Invalid_Digit
cmp al, max_array[esi]
ja Invalid_Digit
